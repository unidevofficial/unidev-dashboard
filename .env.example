# 로컬 개발 전용 설정. 이 파일을 복사해 .env를 만들고 값을 채운다. (.env는 저장소에 올리지 않는다)

# 로컬 PostgreSQL 관리자 접속 정보 (DB 생성·마이그레이션 적용에 사용)
# npm run db:init 을 실행하면 프로젝트 전용 클러스터(.pgdata/, 포트 54329)를 만들고
# 아래 PGPORT·PGPASSWORD를 자동으로 채운다. 이미 쓰는 PostgreSQL 서버가 있으면 그 접속 정보를 직접 적어도 된다.
PGHOST=localhost
PGPORT=54329
PGUSER=postgres
PGPASSWORD=
# 이 프로젝트가 사용할 데이터베이스 이름 (db:reset 시 삭제 후 다시 만든다)
PGDATABASE=unidev

# psql.exe, libpq.dll이 있는 폴더
PG_BIN=C:\Program Files\PostgreSQL\17\bin

# PostgREST가 접속할 때 쓰는 authenticator 역할의 비밀번호 (로컬 전용, 임의 값)
AUTHENTICATOR_PASSWORD=unidev_local_authenticator

# 로컬 개발용 JWT 서명 키 (32자 이상, 로컬 전용. Supabase의 키와 무관)
JWT_SECRET=unidev-local-dev-jwt-secret-change-me-0123456789

# 포트
DEV_PORT=5173
POSTGREST_PORT=3001

# 로그인 아이디를 Supabase Auth의 이메일 형식으로 바꿀 때 붙이는 도메인 (web/config.js와 같은 값)
LOGIN_DOMAIN=unidev.local

# 로컬 개발용 계정(가상 데이터·실제 명단의 개발용 계정) 공통 비밀번호. 로컬 전용
DEV_ACCOUNT_PASSWORD=
