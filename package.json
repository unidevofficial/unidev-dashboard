{
  "name": "unidev-dashboard",
  "private": true,
  "type": "module",
  "description": "UNIDEV 통합 정보 관리 대시보드",
  "scripts": {
    "db:init": "node scripts/db-cluster.mjs init",
    "db:start": "node scripts/db-cluster.mjs start",
    "db:stop": "node scripts/db-cluster.mjs stop",
    "db:status": "node scripts/db-cluster.mjs status",
